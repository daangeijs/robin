# /etc/trailcam-bridge.env — configuration for trailcam-bridge.service
TRAILCAM_SERIAL=/dev/serial/by-id/usb-Silicon_Labs_CP2102_USB_to_UART_Bridge_Controller_0001-if00-port0
TRAILCAM_BAUD=921600
TRAILCAM_DATA_DIR=/var/lib/trailcam-bridge
# timezone for captured_at/fetched_at
TRAILCAM_TZ=Europe/Amsterdam
TRAILCAM_HTTP_HOST=0.0.0.0
TRAILCAM_HTTP_PORT=8090
# empty = no auth; otherwise clients send "Authorization: Bearer <token>"
TRAILCAM_TOKEN=
TRAILCAM_CAMERA_IP=192.168.43.1
# stop downloading after this many seconds so we STOP before the ESP's 15 min watchdog
TRAILCAM_SESSION_BUDGET=720
# seconds without video data before a clip counts as complete
TRAILCAM_VIDEO_IDLE=6
TRAILCAM_MIN_VIDEO_SECONDS=2
TRAILCAM_LOG_LEVEL=INFO
